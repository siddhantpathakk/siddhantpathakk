---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import ProjectCard from '../components/ProjectCard.astro';
import AchievementList from '../components/AchievementList.astro';
import { site } from '../data/site';
import { awards } from '../data/achievements';
import { projects } from '../data/projects';
import { education } from '../data/experience';
import { workProjects } from '../data/work';

const selected = workProjects.filter((p) => p.figure);
const researchSlugs = ['tagon', 'speech-emotion-recognition', 'expected-goals', 'delphi'];
const research = researchSlugs.map((slug) => projects.find((p) => p.slug === slug)!);

const links = [
  { href: site.socials.email, label: 'Email' },
  { href: site.resumeUrl, label: 'CV' },
  { href: site.socials.github, label: 'GitHub' },
  { href: site.socials.linkedin, label: 'LinkedIn' },
  { href: site.socials.x, label: 'X' },
];

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: 'Senior Data Scientist',
  worksFor: { '@type': 'Organization', name: 'Singapore Airlines' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Nanyang Technological University' },
  email: site.email,
  sameAs: [site.socials.github, site.socials.linkedin, site.socials.x],
};
---

<Base>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(personLd)} />

  <section class="pb-12 pt-8 text-center">
    <Photo
      src={site.photos.avatar}
      alt={`Portrait of ${site.name}`}
      width={256}
      sizes="128px"
      aspect="square"
      priority
      class="mx-auto h-32 w-32 rounded-full"
    />
    <h1 class="mt-6 text-4xl font-bold tracking-tight">{site.name}</h1>
    <p class="mt-2 text-lg">Senior Data Scientist at Singapore Airlines</p>
    <p class="text-soft">B.Eng. Computer Science (Honours, Distinction), NTU, CGPA 4.27/5.00</p>
    <ul class="mt-5 flex flex-wrap justify-center gap-x-5 gap-y-1 text-[15px]">
      {links.map((l) => <li><a href={l.href} class="link inline-block py-1">{l.label}</a></li>)}
    </ul>
  </section>

  <section aria-labelledby="about" class="pb-12">
    <h2 id="about" class="mb-3 text-xl font-semibold tracking-tight">About</h2>
    <div class="space-y-4">
      <p>
        I build the GenAI tools Singapore Airlines staff use every day: Agent Builder, a cited search engine for
        travel agents, data-analysis copilots, and the LLM gateway behind 40+ models.
      </p>
      <p>
        I graduated from Nanyang Technological University with a B.Eng. in Computer Science (Honours, Distinction).
        My research sits at the intersection of graph neural networks, sequential recommendation, and applied AI.
      </p>
      <p>
        Outside work I’m drawn to the messy, useful edges of ML: on-device inference, retrieval systems, and anything
        that pushes models out of notebooks and into production.
      </p>
    </div>
  </section>

  <section aria-labelledby="selected-work" class="pb-12">
    <h2 id="selected-work" class="text-xl font-semibold tracking-tight">Selected work at Singapore Airlines</h2>
    <ul class="mt-2">
      {selected.map((p) => (
        <li>
          <a href={`/projects/#${p.slug}`} class="group grid gap-x-6 gap-y-1 py-3 sm:grid-cols-[1fr_auto] sm:items-baseline">
            <span>
              <span class="font-semibold group-hover:underline">{p.title}</span>
              <span class="block text-soft">{p.pitch}</span>
            </span>
            <span class="text-[15px] sm:text-right">
              <span class="inline-block text-right font-semibold tabular-nums" style={`min-width:${p.figure!.value.length}ch`} data-count>{p.figure!.value}</span>
              <span class="text-soft"> {p.figure!.label}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <a href="/projects/" class="link mt-2 inline-block">All projects</a>
  </section>

  <section aria-labelledby="research" class="pb-12">
    <h2 id="research" class="text-xl font-semibold tracking-tight">Research</h2>
    <div class="divide-y-0">
      {research.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section aria-labelledby="education" class="pb-12">
    <h2 id="education" class="mb-3 text-xl font-semibold tracking-tight">Education</h2>
    {education.map((e) => (
      <div>
        <p class="text-[15px] text-soft">{e.period}</p>
        <p class="font-semibold">{e.degree}, {e.institution}</p>
        {e.detail && <p>{e.detail}</p>}
      </div>
    ))}
  </section>

  <section aria-labelledby="awards" class="pb-4">
    <h2 id="awards" class="mb-4 text-xl font-semibold tracking-tight">Awards</h2>
    <AchievementList items={awards} />
  </section>

<script is:inline>
  (() => {
    const els = [...document.querySelectorAll('[data-count]')];
    const section = document.querySelector('[aria-labelledby="selected-work"]');
    if (!els.length || !section || matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    const parts = els.map((el) => {
      const final = el.textContent;
      const m = final.match(/^(\D*)([\d,]+(?:\.\d+)?)(.*)$/);
      return m && { el, final, pre: m[1], suf: m[3], target: parseFloat(m[2].replace(/,/g, '')), dec: (m[2].split('.')[1] || '').length };
    }).filter(Boolean);
    const show = (c, v) => { c.el.textContent = c.pre + v.toLocaleString('en-US', { minimumFractionDigits: c.dec, maximumFractionDigits: c.dec }) + c.suf; };
    parts.forEach((c) => show(c, 0)); // start at zero; the section is below the first screen
    const DURATION = 3600, STAGGER = 400;
    const run = () => parts.forEach((c, i) => {
      const start = performance.now() + i * STAGGER;
      const tick = (now) => {
        const t = Math.min(1, Math.max(0, (now - start) / DURATION));
        show(c, c.target * (1 - Math.pow(1 - t, 3)));
        if (t < 1) requestAnimationFrame(tick);
        else c.el.textContent = c.final;
      };
      requestAnimationFrame(tick);
    });
    // Start once most of the section is on screen, with the bottom fifth of the window ignored.
    const io = new IntersectionObserver((es) => {
      if (es[0].isIntersecting) { run(); io.disconnect(); }
    }, { threshold: 0.6, rootMargin: '0px 0px -15% 0px' });
    io.observe(section);
  })();
</script>
</Base>
