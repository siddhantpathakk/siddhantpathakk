---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../data/site';
import { workProjects } from '../data/work';

const selected = workProjects.filter((p) => p.figure);

const socials = [
  { href: site.socials.github, label: 'GitHub', external: true },
  { href: site.socials.linkedin, label: 'LinkedIn', external: true },
  { href: site.socials.x, label: 'X', external: true },
  { href: site.socials.email, label: 'Email', external: false },
];

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: 'Data Scientist',
  worksFor: { '@type': 'Organization', name: 'Singapore Airlines' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Nanyang Technological University' },
  email: site.email,
  sameAs: [site.socials.github, site.socials.linkedin, site.socials.x],
};
---

<Base>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(personLd)} />

  <section class="pt-12 sm:pt-20 pb-12 grid gap-8 sm:grid-cols-[1fr_auto] sm:items-start sm:gap-12">
    <div class="max-w-2xl">
      <h1 class="text-5xl sm:text-7xl font-bold tracking-display leading-[1.02]">{site.name}</h1>
      <p class="mt-5 text-xl sm:text-2xl leading-snug text-slate-700 dark:text-slate-300">
        Data Scientist building production GenAI at
        <span class="text-slate-900 dark:text-white font-medium">Singapore Airlines</span>.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/projects/"
          class="inline-flex items-center rounded-md bg-indigo-600 dark:bg-indigo-500 text-white px-4 py-2.5 text-sm font-medium hover:bg-indigo-700 dark:hover:bg-indigo-400 motion-safe:active:scale-[0.97] transition-[background-color,transform] duration-150 ease-out-strong"
        >
          View projects
        </a>
        <a
          href="/resume/"
          class="inline-flex items-center rounded-md border border-slate-300 dark:border-slate-700 px-4 py-2.5 text-sm font-medium hover:bg-slate-50 dark:hover:bg-slate-900 motion-safe:active:scale-[0.97] transition-[background-color,transform] duration-150 ease-out-strong"
        >
          Resume
        </a>
      </div>
    </div>
    <Photo
      src={site.photos.avatar}
      alt={`Portrait of ${site.name}`}
      width={176}
      sizes="(min-width: 640px) 176px, 112px"
      aspect="square"
      rounded="2xl"
      priority
      class="order-first h-28 w-28 sm:order-none sm:h-44 sm:w-44"
    />
  </section>

  <section class="pb-16">
    <div class="max-w-2xl space-y-5 text-base sm:text-lg text-slate-700 dark:text-slate-300 leading-relaxed">
      <p>
        I build Agent Builder, which turns a plain-English request into a tested AI workflow; a cited RAG search
        engine for B2B travel agents; data-analysis copilots; and the enterprise LLM gateway that routes traffic to
        40+ models across 4 providers.
      </p>
      <p>
        I graduated from <span class="text-slate-900 dark:text-white font-medium">Nanyang Technological University</span>
        with a B.Eng. in Computer Science (Honours, Distinction). My research
        sits at the intersection of graph neural networks, sequential recommendation, and applied AI.
      </p>
      <p>
        Outside work I’m drawn to the messy, useful edges of ML: on-device inference, retrieval systems, and
        anything that pushes models out of notebooks and into production.
      </p>
    </div>

    <ul class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm text-slate-600 dark:text-slate-400">
      {socials.map((s) => (
        <li>
          <a href={s.href} class="inline-flex items-center gap-1 py-1 hover:text-indigo-700 dark:hover:text-indigo-400 transition-colors">
            {s.label}
            {s.external && <Arrow direction="up-right" class="h-3 w-3" />}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="selected-work" class="pb-8">
    <h2 id="selected-work" class="text-xl font-semibold tracking-tight">Selected work at Singapore Airlines</h2>
    <ul class="mt-4 -mx-3">
      {selected.map((p) => (
        <li>
          <a
            href={`/projects/#${p.slug}`}
            class="group grid gap-y-2 rounded-lg px-3 py-4 hover:bg-slate-50 dark:hover:bg-slate-900 transition-colors sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-x-6"
          >
            <span>
              <span class="block font-semibold group-hover:text-indigo-700 dark:group-hover:text-indigo-400 transition-colors">{p.title}</span>
              <span class="mt-0.5 block text-slate-600 dark:text-slate-400">{p.pitch}</span>
            </span>
            <span class="flex items-baseline gap-2 sm:block sm:text-right">
              <span class="block text-2xl sm:text-3xl font-semibold tracking-display tabular-nums">{p.figure!.value}</span>
              <span class="block text-sm text-slate-600 dark:text-slate-400">{p.figure!.label}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <a
      href="/projects/"
      class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-indigo-700 dark:text-indigo-400 hover:underline"
    >
      All projects
      <Arrow />
    </a>
  </section>
</Base>
