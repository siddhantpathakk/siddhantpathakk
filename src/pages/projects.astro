---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import WorkProjectCard from '../components/WorkProjectCard.astro';
import { projects } from '../data/projects';
import { workProjects } from '../data/work';
---

<Base
  title="Projects · Siddhant Pathak"
  description="Production GenAI at Singapore Airlines, plus research and side projects in graph neural networks and applied ML."
>
  <PageHeader
    title="Things I’ve built"
    lede="Production GenAI systems at Singapore Airlines, plus research and side projects spanning graph neural networks, agents, sports analytics, and applied ML."
  />

  <section aria-labelledby="at-sia" class="pb-16">
    <h2 id="at-sia" class="text-xl font-semibold tracking-tight">At Singapore Airlines</h2>
    <div class="mt-8 space-y-12">
      {workProjects.map((p) => <WorkProjectCard project={p} />)}
    </div>
    <p class="mt-10 text-sm text-slate-500 dark:text-slate-400">Figures as of October 2026, rounded.</p>
  </section>

  <section aria-labelledby="research" class="pb-12">
    <h2 id="research" class="text-xl font-semibold tracking-tight">Research &amp; side projects</h2>
    <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
</Base>
