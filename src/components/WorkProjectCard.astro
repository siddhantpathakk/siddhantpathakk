---
import type { WorkProjectItem } from '../data/work';
import Arrow from './Arrow.astro';

interface Props {
  project: WorkProjectItem;
}

const { project } = Astro.props;
---

<article id={project.slug} class="scroll-mt-6 py-6 target:bg-surface">
  <h3 class="text-lg font-semibold tracking-tight">
    {project.title}
    {project.href && (
      <a href={project.href} class="link ml-2 inline-flex items-center gap-1 text-[15px] font-normal">
        Live site <Arrow direction="up-right" />
      </a>
    )}
  </h3>
  <p class="text-soft">{project.pitch}</p>
  <ul class="mt-3 list-disc space-y-2 pl-5 marker:text-soft">
    {project.highlights.map((h) => <li>{h}</li>)}
  </ul>
</article>
