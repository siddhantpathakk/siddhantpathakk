---
import type { WorkProjectItem } from '../data/work';
import { accents } from '../lib/accents';

interface Props {
  project: WorkProjectItem;
}

const { project } = Astro.props;
const a = accents[project.accent];
const Tag = project.href ? 'a' : 'div';
---

<Tag
  href={project.href}
  target={project.href ? '_blank' : undefined}
  rel={project.href ? 'noopener noreferrer' : undefined}
  class:list={[
    'group block rounded-xl border border-slate-200 dark:border-slate-800 p-5',
    project.href && [a.hoverBorder, a.hoverBg],
  ]}
>
  <h3 class:list={['font-semibold tracking-tight', project.href && a.titleHover]}>
    {project.title}{project.href && ' ↗'}
  </h3>
  <p class="mt-1 text-sm text-slate-700 dark:text-slate-200">{project.pitch}</p>
  <ul class="mt-3 space-y-1.5 text-sm text-slate-600 dark:text-slate-300 leading-relaxed list-disc pl-4">
    {project.highlights.map((h) => <li>{h}</li>)}
  </ul>
</Tag>
