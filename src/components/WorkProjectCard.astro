---
import type { WorkProjectItem } from '../data/work';
import Arrow from './Arrow.astro';

interface Props {
  project: WorkProjectItem;
}

const { project } = Astro.props;
---

<article
  id={project.slug}
  class="relative isolate grid gap-x-10 gap-y-3 sm:grid-cols-[15rem_1fr] before:absolute before:-inset-x-3 before:-inset-y-4 before:-z-10 before:rounded-xl before:bg-indigo-50 dark:before:bg-indigo-950/50 before:opacity-0 target:before:animate-[target-fade_1.6s_var(--ease-out-strong)]"
>
  <div>
    <h3 class="text-lg font-semibold tracking-tight">{project.title}</h3>
    <p class="mt-1 text-slate-600 dark:text-slate-400 leading-relaxed">{project.pitch}</p>
    {project.href && (
      <a
        href={project.href}
        class="group mt-3 inline-flex items-center gap-1 text-sm font-medium text-indigo-700 dark:text-indigo-400 hover:underline"
      >
        Live site
        <Arrow direction="up-right" />
      </a>
    )}
  </div>
  <ul class="list-disc space-y-2 pl-5 text-slate-700 dark:text-slate-300 leading-relaxed marker:text-slate-400 dark:marker:text-slate-600">
    {project.highlights.map((h) => <li>{h}</li>)}
  </ul>
</article>
