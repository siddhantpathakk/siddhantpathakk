---

<button
  id="theme-toggle"
  type="button"
  aria-label="Dark theme"
  aria-pressed="false"
  class="inline-flex h-11 w-11 items-center justify-center rounded-full text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 motion-safe:active:scale-[0.97] transition-[background-color,transform] duration-150 ease-out-strong"
>
  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m4.93 19.07 1.41-1.41"/><path d="m17.66 6.34 1.41-1.41"/></svg>
  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
</button>

<script is:inline>
  (() => {
    const btn = document.getElementById('theme-toggle');
    const root = document.documentElement;
    const meta = document.querySelector('meta[name="theme-color"]');
    const apply = (dark) => {
      root.classList.toggle('dark', dark);
      btn?.setAttribute('aria-pressed', String(dark));
      meta?.setAttribute('content', dark ? '#020618' : '#ffffff');
    };
    apply(root.classList.contains('dark'));
    btn?.addEventListener('click', () => {
      const dark = !root.classList.contains('dark');
      apply(dark);
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      } catch {}
    });
  })();
</script>
