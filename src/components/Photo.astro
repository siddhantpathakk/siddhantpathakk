---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Largest CSS width the photo is shown at; the srcset is generated from it. */
  width: number;
  sizes: string;
  aspect?: 'square' | 'portrait' | 'landscape';
  rounded?: 'lg' | 'xl' | '2xl';
  position?: string;
  priority?: boolean;
  class?: string;
}

const {
  src,
  alt,
  width,
  sizes,
  aspect = 'landscape',
  rounded = 'xl',
  position = 'center',
  priority = false,
  class: className = '',
} = Astro.props;

const aspectClass = {
  square: 'aspect-square',
  portrait: 'aspect-[3/4]',
  landscape: 'aspect-[4/3]',
}[aspect];

const heightRatio = { square: 1, portrait: 4 / 3, landscape: 3 / 4 }[aspect];

const roundedClass = {
  lg: 'rounded-lg',
  xl: 'rounded-xl',
  '2xl': 'rounded-2xl',
}[rounded];
---

<div class:list={['overflow-hidden bg-slate-100 dark:bg-slate-900', aspectClass, roundedClass, className]}>
  <Image
    src={src}
    alt={alt}
    width={width}
    height={Math.round(width * heightRatio)}
    layout="constrained"
    fit="cover"
    position={position}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    class="h-full w-full object-cover"
  />
</div>
