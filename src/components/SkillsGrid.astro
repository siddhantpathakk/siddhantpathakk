---
import type { SkillGroup } from '../data/skills';

interface Props {
  groups: SkillGroup[];
}

const { groups } = Astro.props;
---

<div class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
  {groups.map((g) => (
    <div>
      <h3 class="font-semibold tracking-tight">{g.title}</h3>
      <ul class="mt-3 flex flex-wrap gap-1.5">
        {g.items.map((i) => (
          <li class="rounded-md bg-slate-100 dark:bg-slate-800/80 px-2 py-0.5 text-sm text-slate-700 dark:text-slate-300">
            {i}
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
