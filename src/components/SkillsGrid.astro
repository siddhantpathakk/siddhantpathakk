---
import type { SkillGroup } from '../data/skills';

interface Props {
  groups: SkillGroup[];
}

const { groups } = Astro.props;
---

<dl class="space-y-3">
  {groups.map((g) => (
    <div>
      <dt class="font-semibold">{g.title}</dt>
      <dd class="text-soft">{g.items.join(', ')}</dd>
    </div>
  ))}
</dl>
