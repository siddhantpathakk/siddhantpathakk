---
import { site } from '../data/site';

const socials = [
  { href: site.socials.github, label: 'GitHub' },
  { href: site.socials.linkedin, label: 'LinkedIn' },
  { href: site.socials.x, label: 'X' },
  { href: site.socials.email, label: 'Email' },
];
---

<footer class="mx-auto max-w-[44rem] px-5 pb-12 pt-20 text-center text-[15px] text-soft">
  <ul class="flex flex-wrap justify-center gap-x-5 gap-y-1">
    {socials.map((s) => <li><a href={s.href} class="link py-1 inline-block">{s.label}</a></li>)}
  </ul>
  <p class="mt-4">{site.name}, Singapore</p>
</footer>
