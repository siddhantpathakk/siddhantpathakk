---
import type { ProjectItem } from '../data/projects';
import { site } from '../data/site';
import Arrow from './Arrow.astro';

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;

const linkLabel =
  project.href.replace(/\/$/, '') === site.socials.github
    ? 'GitHub profile'
    : project.href.startsWith('https://github.com/')
      ? 'Code on GitHub'
      : 'Live site';
---

<article id={project.slug} class="scroll-mt-6 py-6">
  <h3 class="text-lg font-semibold tracking-tight">{project.title}</h3>
  {project.tags.length > 0 && <p class="text-[15px] text-soft">{project.tags.join(', ')}</p>}
  <p class="mt-2">{project.summary}</p>
  <a href={project.href} class="link group mt-2 inline-flex items-center gap-1 text-[15px]">
    {linkLabel} <Arrow direction="up-right" />
  </a>
</article>
