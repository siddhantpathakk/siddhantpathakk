---
interface Props {
  direction?: 'right' | 'up-right';
  class?: string;
}

const { direction = 'right', class: className = 'h-3.5 w-3.5' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {direction === 'right' ? (
    <><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></>
  ) : (
    <><path d="M7 7h10v10" /><path d="M7 17 17 7" /></>
  )}
</svg>
