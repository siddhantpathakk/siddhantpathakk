---
import type { Award } from '../data/achievements';
import Photo from './Photo.astro';

interface Props {
  items: Award[];
}

const { items } = Astro.props;
---

<ul class="space-y-8">
  {items.map((item) => (
    <li class="grid gap-4 sm:grid-cols-[1fr_9rem] sm:items-start">
      <div>
        {item.year && <p class="text-[15px] text-soft">{item.year}</p>}
        <p class="font-semibold">{item.title}</p>
        {item.detail && <p class="mt-1">{item.detail}</p>}
      </div>
      {item.image && (
        <Photo
          src={item.image.src}
          alt={item.image.alt}
          width={288}
          sizes="(min-width: 640px) 9rem, 100vw"
          aspect="landscape"
          class="max-w-xs sm:max-w-none"
        />
      )}
    </li>
  ))}
</ul>
