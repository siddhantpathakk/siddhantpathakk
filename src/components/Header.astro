---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';

const links = [
  { href: '/projects/', label: 'Projects' },
  { href: '/resume/', label: 'Resume' },
];

const strip = (path: string) => path.replace(/\/$/, '') || '/';
const normalized = strip(Astro.url.pathname);
const isActive = (href: string) => normalized === strip(href) || normalized.startsWith(href);
---

<header
  class="sticky top-0 z-40 bg-white dark:bg-slate-950 border-b border-slate-200/60 dark:border-slate-800/60 [view-transition-name:site-header]"
>
  <nav aria-label="Main" class="mx-auto max-w-4xl px-4 sm:px-6 h-14 flex items-center justify-between gap-2">
    <a
      href="/"
      aria-current={normalized === '/' ? 'page' : undefined}
      class="inline-flex h-11 items-center font-semibold tracking-tight text-sm sm:text-base hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors"
    >
      {site.name}
    </a>
    <div class="flex items-center">
      <ul class="flex items-center">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={isActive(l.href) ? 'page' : undefined}
              class="inline-flex h-11 items-center px-2.5 sm:px-3 text-sm font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors aria-[current=page]:text-slate-900 dark:aria-[current=page]:text-white aria-[current=page]:underline aria-[current=page]:decoration-indigo-500 aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-[6px]"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>
