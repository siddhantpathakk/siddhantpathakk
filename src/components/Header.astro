---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  { href: '/resume/', label: 'Resume' },
];

const strip = (path: string) => path.replace(/\/$/, '') || '/';
const normalized = strip(Astro.url.pathname);
const isActive = (href: string) => normalized === strip(href);
---

<header class="bg-ground [view-transition-name:site-header]">
  <nav aria-label="Main" class="mx-auto flex max-w-[44rem] items-center justify-center gap-1 px-5 pt-3 text-[15px]">
    {links.map((l) => (
      <a
        href={l.href}
        aria-current={isActive(l.href) ? 'page' : undefined}
        class="inline-flex h-11 items-center px-3 text-soft hover:text-ink aria-[current=page]:font-semibold aria-[current=page]:text-ink"
      >
        {l.label}
      </a>
    ))}
    <ThemeToggle />
  </nav>
</header>
