---
interface Props {
  title: string;
  lede?: string;
}

const { title, lede } = Astro.props;
---

<header class="pt-16 pb-10 sm:pt-24 sm:pb-12">
  <h1 class="text-4xl sm:text-5xl font-bold tracking-display leading-[1.05]">{title}</h1>
  {lede && (
    <p class="mt-4 text-lg text-slate-700 dark:text-slate-300 max-w-2xl leading-relaxed">{lede}</p>
  )}
</header>
