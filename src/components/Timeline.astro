---
import type { ExperienceItem, EducationItem } from '../data/experience';

interface Props {
  items: ExperienceItem[] | EducationItem[];
  variant?: 'work' | 'education';
}

const { items, variant = 'work' } = Astro.props;

function isExperience(item: ExperienceItem | EducationItem): item is ExperienceItem {
  return (item as ExperienceItem).role !== undefined;
}

type Segment = { type: 'text'; value: string } | { type: 'link'; value: string; href: string };

function linkify(text: string, links?: { label: string; href: string }[]): Segment[] {
  if (!links?.length) return [{ type: 'text', value: text }];
  const escapeRegex = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const pattern = new RegExp(`(${links.map((l) => escapeRegex(l.label)).join('|')})`, 'g');
  const hrefByLabel = new Map(links.map((l) => [l.label, l.href]));
  return text.split(pattern).map((part) =>
    hrefByLabel.has(part)
      ? { type: 'link', value: part, href: hrefByLabel.get(part)! }
      : { type: 'text', value: part },
  );
}

const linkClass =
  'text-indigo-700 dark:text-indigo-400 underline decoration-indigo-300 dark:decoration-indigo-700 hover:decoration-current transition-colors';
---

<ol class="space-y-10 border-l border-slate-200 dark:border-slate-800 pl-6">
  {items.map((item) => {
    const isCurrent = isExperience(item) && item.current;
    const dotClass = isCurrent
      ? 'bg-emerald-500 ring-4 ring-emerald-500/20'
      : variant === 'education'
        ? 'bg-slate-300 dark:bg-slate-700'
        : 'bg-slate-400 dark:bg-slate-600';

    return (
      <li class="relative">
        <span class={`absolute -left-[29px] top-1.5 h-3 w-3 rounded-full ${dotClass}`} aria-hidden="true"></span>
        <p class="text-sm font-medium text-slate-500 dark:text-slate-400 tabular-nums">{item.period}</p>
        {isExperience(item) ? (
          <>
            <p class="mt-0.5 font-semibold">
              {item.role}
              <span class="text-slate-600 dark:text-slate-400 font-normal">
                {' · '}
                {item.companyUrl ? (
                  <a href={item.companyUrl} class="hover:text-indigo-700 dark:hover:text-indigo-400 hover:underline transition-colors">{item.company}</a>
                ) : (
                  <>{item.company}</>
                )}
              </span>
            </p>
            <ul class="mt-2 max-w-2xl list-disc space-y-1.5 pl-5 text-slate-700 dark:text-slate-300 leading-relaxed marker:text-slate-400 dark:marker:text-slate-600">
              {item.highlights.map((h) => (
                <li>
                  {linkify(h, item.links).map((seg) =>
                    seg.type === 'link' ? <a href={seg.href} class={linkClass}>{seg.value}</a> : <>{seg.value}</>,
                  )}
                </li>
              ))}
            </ul>
          </>
        ) : (
          <>
            <p class="mt-0.5 font-semibold">
              {item.degree}
              <span class="text-slate-600 dark:text-slate-400 font-normal"> · {item.institution}</span>
            </p>
            {item.detail && (
              <p class="mt-1 max-w-2xl text-slate-700 dark:text-slate-300 leading-relaxed">{item.detail}</p>
            )}
          </>
        )}
      </li>
    );
  })}
</ol>
